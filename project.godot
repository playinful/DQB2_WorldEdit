;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Eye of Rubiss"
config/version="Indev 5-25-2025"
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.5", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[dotnet]

project/assembly_name="DQB2_WorldEdit"

[editor]

movie_writer/movie_file="C:/Users/walke/Videos/GodotMovie.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/native_dialogs/plugin.cfg")

